    build_file = "//designs/src/sha3:external.BUILD.bazel",
    sha256 = "c0b1511c15783ce661ec07e989bc5185cad806d680d16d50adc8ca925ef33f76",
    strip_prefix = "sha3-8fe970e9f96beef84ee7065d3050cd73c5b106e9",
