http_archive(
    name = "liteiclink_src",
    build_file = "//designs/src/liteeth:liteiclink.BUILD.bazel",
    sha256 = "f1fbc023bd5b7d01eebb1ffe2badb35fd2ba922bc97d1e59ba4d240200df3a9e",
    strip_prefix = "liteiclink-ef9c29506c9c8e5d733a54403c6a9ec1df5babd5",
