# coralnpu RTL is generated hermetically by Bazel from Chisel 7 (CIRCT/firtool)
# — see designs/src/coralnpu/chisel/BUILD.bazel (@coralnpu + its rocket-chip /
# cvfpu / diplomacy / common_cells dep graph, elaborated to SystemVerilog).
# Fed to yosys-slang (SYNTH_HDL_FRONTEND=slang) on the platform designs.
#
# macros.v carries the FakeRAM wrappers (fakeram_512x128 / fakeram_2048x128)
# that the patched Sram_* memory blackboxes instantiate; sram/ LEF+LIB provide
# the fakeram_*_1rw hard macros.  No dev/repo submodule, no sv2v/perl setup.sh.
filegroup(
    name = "rtl",
    srcs = [
        "//designs/src/coralnpu/chisel:coralnpu_all_sv",
        "macros.v",
    ],
    visibility = ["//visibility:public"],
)
