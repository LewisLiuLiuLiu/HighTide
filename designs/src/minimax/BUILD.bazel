# minimax RTL: upstream SystemVerilog (gsmecher/minimax @ cb62251, via
# @minimax_src) lowered to Verilog-2005 by sv2v (pinned v0.0.13, @sv2v).
# Fully hermetic — no dev/repo submodule, no dev/setup.sh (which built sv2v
# from an unpinned Haskell Stack checkout).  Consumers keep the stable
# //designs/src/minimax:rtl label.
genrule(
    name = "gen_minimax",
    srcs = ["@minimax_src//:minimax_sv"],
    outs = ["minimax.v"],
    cmd = "$(execpath @sv2v//:sv2v_bin) -w $@ $(execpath @minimax_src//:minimax_sv)",
    tools = ["@sv2v//:sv2v_bin"],
)

alias(
    name = "rtl",
    actual = ":gen_minimax",
    visibility = ["//visibility:public"],
)
