# litepci (LitePCIe controller) — RTL generated hermetically by Bazel from the
# upstream enjoy-digital/litepcie standalone generator (@litepci_src) run under
# the shared LiteX toolchain (@litex_src + pip_litex), then post-processed by
# three stdlib-only helper scripts.  No dev/repo submodule, no sbt/venv setup.sh.
#
# Pipeline (mirrors the retired dev/gen.sh):
#   litepci_gen kcu105.yml            -> build/gateware/litepcie_core.v (+ .init)
#   inline_readmemh core.v core.init  -> inline the CSR $readmemh identifier
#   gen_phy_stub    core.v            -> pcie_us_stub.v  (Xilinx PCIe hard-IP blackbox)
#   inline_fakeram  core.v            -> swap inferred mem reg-arrays for fakeram
# The per-platform pcie_us LEF/LIB (designs/<plat>/litepci/phy/) stay committed.

load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "litepci_gen",
    srcs = ["litepci_gen_main.py"],
    main = "litepci_gen_main.py",
    visibility = ["//visibility:private"],
    deps = ["@litepci_src//:litepcie"],
)

# Post-processing helpers (stdlib-only, no deps).
py_binary(
    name = "inline_readmemh",
    srcs = ["dev/inline_readmemh.py"],
    main = "dev/inline_readmemh.py",
    visibility = ["//visibility:private"],
)

py_binary(
    name = "inline_fakeram",
    srcs = ["dev/inline_fakeram.py"],
    main = "dev/inline_fakeram.py",
    visibility = ["//visibility:private"],
)

py_binary(
    name = "gen_phy_stub",
    srcs = ["dev/gen_phy_stub.py"],
    main = "dev/gen_phy_stub.py",
    visibility = ["//visibility:private"],
)

genrule(
    name = "gen_litepci",
    srcs = ["kcu105.yml"],
    outs = [
        "litepcie_core.v",
        "pcie_us_stub.v",
    ],
    cmd = """
set -e
GEN=$$(readlink -f $(execpath :litepci_gen))
IRM=$$(readlink -f $(execpath :inline_readmemh))
IFR=$$(readlink -f $(execpath :inline_fakeram))
GPS=$$(readlink -f $(execpath :gen_phy_stub))
YML=$$(readlink -f $(execpath kcu105.yml))
GENDIR=$$(pwd)/_litepci_gen
mkdir -p "$$GENDIR"
( cd "$$GENDIR" && PYTHONHASHSEED=0 HOME="$$GENDIR" "$$GEN" "$$YML" ) >/dev/null
CORE="$$GENDIR/build/gateware/litepcie_core.v"
"$$IRM" "$$CORE" "$$GENDIR/build/gateware/litepcie_core_mem.init"
"$$GPS" "$$CORE" --module pcie_us --out "$$GENDIR/pcie_us_stub.v"
"$$IFR" "$$CORE"
sed -E -i \
    -e 's|^// Date       : .*|// Date       : (normalized for reproducible build)|' \
    -e 's|^//  Auto-Generated by LiteX on .*|//  Auto-Generated by LiteX (normalized for reproducible build)|' \
    "$$CORE"
cp "$$CORE" $(execpath litepcie_core.v)
cp "$$GENDIR/pcie_us_stub.v" $(execpath pcie_us_stub.v)
rm -rf "$$GENDIR"
""",
    tools = [
        ":litepci_gen",
        ":inline_readmemh",
        ":inline_fakeram",
        ":gen_phy_stub",
    ],
)

# Xilinx primitive stubs the generated Verilog instantiates.  pcie_us is the
# only true blackbox (Xilinx PCIe hard IP, provided as a per-platform LEF).
filegroup(
    name = "xilinx_libs",
    srcs = [
        "//designs/src/liteeth:xilinx_libs",
        "libraries/xilinx/IBUFDS_GTE3.v",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "rtl",
    srcs = [
        ":gen_litepci",
        ":xilinx_libs",
    ],
    visibility = ["//visibility:public"],
)
