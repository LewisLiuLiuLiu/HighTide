# NVDLA shared RTL.
#
# All 5 partitions (a, c, m, o, p) compile against the same vmod tree.
# Per verilog.mk, only vmod/{rams/synth, vlibs, nvdla} + macros.v are
# fed to synthesis; vmod/rams/{model,fpga} are simulation-only.
#
# NVDLA is the one HighTide design whose RTL is NOT hermetically fetchable.
# vmod/ is the *output* of NVDLA's legacy spec build (Perl 5.10.1 + Python
# 2.7.18 + JDK11 + SystemC 2.3.0 running `perl tools/bin/tmake -build vmod`
# over the parameterized nvdla/hw nv_small source, then substituting a
# pre-baked NV_NVDLA_cfgrom.v) — a toolchain that cannot be reproduced as a
# hermetic Bazel genrule.  So vmod/ stays committed and the Bazel build reads
# it directly; there is no submodule and no build-time generation.
#
# To refresh vmod/ (rare), run dev/setup.sh: it clones the pinned nvdla/hw
# nv_small source on demand (SHA 771f20cc, into the gitignored dev/repo/,
# replacing the retired submodule), installs the legacy toolchain, runs tmake,
# and re-stages vmod/.  Heavyweight (multi-hour, network) and manual.

filegroup(
    name = "include",
    srcs = glob([
        "vmod/include/*.vh",
        "vmod/vlibs/*.vh",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "rtl_release",
    srcs = glob([
        "vmod/rams/synth/*.v",
        "vmod/vlibs/*.v",
        "vmod/nvdla/**/*.v",
        # Behavioural reg-array stubs (synthesize to FFs) for the 6 SRAM
        # sizes that don't get bsg_fakeram LEF/LIB — sub-1KB + the
        # depth-16 entries CACTI can't size on nangate45/sky130hd.
        # Generated by dev/gen_ff_rams.py.
        "dev/generated/sram_ff/*.v",
    ]) + [
        "macros.v",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "rtl",
    actual = ":rtl_release",
    visibility = ["//visibility:public"],
)
