# lfsr RTL is fetched hermetically from upstream via @lfsr_src
# (alexforencich/verilog-lfsr, pinned in the root MODULE.bazel).
# No submodule, no setup.sh, no vendored copy — see external.BUILD.bazel.
alias(
    name = "rtl",
    actual = "@lfsr_src//:rtl",
    visibility = ["//visibility:public"],
)
