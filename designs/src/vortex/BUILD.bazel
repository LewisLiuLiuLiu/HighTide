# Vortex GPGPU — SystemVerilog synthesized via yosys-slang.
#
# RTL is fetched hermetically from upstream vortexgpgpu/vortex (@vortex_src);
# the design compiles the VORTEX_FILES subset of hw/rtl/, with the upstream
# generic VX_dp_ram / VX_sp_ram primitives overlaid by the local FakeRAM-aware
# stubs (VX_dp_ram.sv / VX_sp_ram.sv).  No dev/repo submodule, no setup.sh.

load("//designs/src/vortex:srcs.bzl", "VORTEX_FILES")

# The two RAM primitives replaced by the local FakeRAM-aware stubs.
_REPLACED = [
    "libs/VX_dp_ram.sv",
    "libs/VX_sp_ram.sv",
]

_UPSTREAM = ["@vortex_src//:hw/rtl/" + f for f in VORTEX_FILES if f not in _REPLACED]

filegroup(
    name = "rtl",
    srcs = _UPSTREAM + [
        "VX_dp_ram.sv",
        "VX_sp_ram.sv",
    ],
    visibility = ["//visibility:public"],
)

# All compile sources + upstream headers, staged into the synth sandbox so
# `include "VX_platform.vh" etc. resolve via VERILOG_INCLUDE_DIRS.
filegroup(
    name = "rtl_data",
    srcs = [
        ":rtl",
        "@vortex_src//:headers",
    ],
    visibility = ["//visibility:public"],
)
