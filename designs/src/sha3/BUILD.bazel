load("@rules_scala//scala:scala.bzl", "scala_binary")

# sha3 RTL is generated hermetically by Bazel from Chisel 3.6.1: the upstream
# ucb-bar/sha3 Chisel sources (@sha3_src) + the checked-in Sha3Top/DpathModule/
# emitter are compiled and run under rules_scala (Maven-pinned chisel3 3.6.1,
# Scala 2.13.12) — no dev/repo submodule, no sbt-from-curl in dev/setup.sh.
# Consumers keep the stable //designs/src/sha3:rtl label.
scala_binary(
    name = "sha3_emitter",
    srcs = [
        "dev/src/main/scala/sha3/DpathModule.scala",
        "dev/src/main/scala/sha3/Sha3Top.scala",
        "@sha3_src//:core_scala",
    ],
    main_class = "sha3.Sha3Emitter",
    plugins = ["@maven_chisel//:edu_berkeley_cs_chisel3_plugin_2_13_12"],
    scalacopts = ["-Xcheckinit"],
    deps = [
        "@maven_chisel//:edu_berkeley_cs_chisel3_2_13",
        "@maven_chisel//:edu_berkeley_cs_firrtl_2_13",
    ],
)

# Run the emitter (writes generated/sha3.v) and normalize Chisel's @[...]
# source-location comments — they embed the absolute compile-time path to each
# .scala file (incl. the bazel cache hash), so strip that prefix down to a
# stable src/main/scala/... path for byte-reproducible output.
genrule(
    name = "gen_sha3",
    outs = ["sha3.v"],
    cmd = """
set -e
BIN=$$(readlink -f $(execpath :sha3_emitter))
GENDIR=$$(pwd)/_sha3_gen
mkdir -p "$$GENDIR"
( cd "$$GENDIR" && "$$BIN" ) >/dev/null
sed -E 's#@\\[([^]]*/)?(src/main/scala/[^]]*)\\]#@[\\2]#g' "$$GENDIR/generated/sha3.v" > $@
rm -rf "$$GENDIR"
""",
    tools = [":sha3_emitter"],
)

alias(
    name = "rtl",
    actual = ":gen_sha3",
    visibility = ["//visibility:public"],
)
