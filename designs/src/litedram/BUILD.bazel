# RTL sources for the LiteDRAM standalone-core benchmark.
#
# litedram_core.v is generated hermetically by Bazel from the upstream
# enjoy-digital/litedram standalone generator: migen/litex/litedram are
# fetched as pinned source archives (@migen_src/@litex_src/@litedram_src in
# the root MODULE.bazel) and run under the :litedram_gen py_binary — no git
# submodule, no dev/setup.sh venv.  See :gen_litedram_core below.
#
# `libraries/lattice/*.v` provides ASIC-synthesizable stubs for the four
# Lattice ECP5 primitives that GENSDRPHY's I/O cells instantiate
# (FD1S3BX, OFS1P3BX, IFS1P3BX, TRELLIS_IO) — the core controller logic
# itself has no vendor dependency.  These are HighTide-authored, not
# upstream, so they stay checked in.

load("@rules_python//python:defs.bzl", "py_binary")

# Hermetic LiteDRAM standalone-core generator (migen/litex/litedram fetched
# as source archives; see root MODULE.bazel).  Replaces dev/setup.sh's venv.
py_binary(
    name = "litedram_gen",
    srcs = ["litedram_gen_main.py"],
    main = "litedram_gen_main.py",
    visibility = ["//visibility:private"],
    deps = ["@litedram_src//:litedram"],
)

# Run the generator on litedram.yml, apply the sdram_dq input->inout source
# fix (declarative patch), and normalize LiteX's build-timestamp header lines
# so the output is byte-reproducible (deterministic Bazel caching).
# PYTHONHASHSEED=0 pins LiteX's blackbox-listing order in the header comment.
genrule(
    name = "gen_litedram_core",
    srcs = [
        "litedram.yml",
        "patches/litedram_core_sdram_dq_inout.patch",
    ],
    outs = ["litedram_core.v"],
    cmd = """
set -e
BIN=$$(readlink -f $(execpath :litedram_gen))
YML=$$(readlink -f $(execpath litedram.yml))
PATCHF=$$(readlink -f $(execpath patches/litedram_core_sdram_dq_inout.patch))
GENDIR=$$(pwd)/_litedram_gen
mkdir -p "$$GENDIR"
( cd "$$GENDIR" && PYTHONHASHSEED=0 HOME="$$GENDIR" "$$BIN" "$$YML" ) >/dev/null
CORE="$$GENDIR/build/gateware/litedram_core.v"
patch -s "$$CORE" "$$PATCHF"
sed -E -i \
    -e 's|^// Date       : .*|// Date       : (normalized for reproducible build)|' \
    -e 's|^//  Auto-Generated by LiteX on .*|//  Auto-Generated by LiteX (normalized for reproducible build)|' \
    "$$CORE"
cp "$$CORE" $@
rm -rf "$$GENDIR"
""",
    tools = [":litedram_gen"],
)

filegroup(
    name = "lattice_libs",
    srcs = glob(["libraries/lattice/*.v"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "litedram_rtl",
    srcs = [
        ":gen_litedram_core",
        ":lattice_libs",
    ],
    visibility = ["//visibility:public"],
)
