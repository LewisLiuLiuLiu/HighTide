load("@rules_scala//scala:scala.bzl", "scala_binary")

# gemmini RTL is generated hermetically by Bazel from Chisel 3.6.1: the upstream
# ucb-bar/gemmini Chisel sources (@gemmini_src) + the checked-in GemminiMeshTop/
# Arithmetic/emitter are compiled and run under rules_scala (Maven-pinned
# chisel3 3.6.1, Scala 2.13.12) — no dev/repo submodule, no sbt-from-curl.
# Consumers keep the stable //designs/src/gemmini:rtl label.
scala_binary(
    name = "gemmini_emitter",
    srcs = [
        "dev/src/main/scala/gemmini/Arithmetic.scala",
        "dev/src/main/scala/gemmini/GemminiMeshTop.scala",
        "@gemmini_src//:core_scala",
    ],
    main_class = "gemmini.GemminiMeshEmitter",
    plugins = ["@maven_chisel//:edu_berkeley_cs_chisel3_plugin_2_13_12"],
    scalacopts = ["-Xcheckinit"],
    deps = [
        "@maven_chisel//:edu_berkeley_cs_chisel3_2_13",
        "@maven_chisel//:edu_berkeley_cs_firrtl_2_13",
    ],
)

# Run the emitter (writes generated/gemmini.v) and normalize Chisel's @[...]
# source-location comments (they embed the absolute compile-time path incl. the
# bazel cache hash) down to a stable src/main/scala/... path for reproducibility.
genrule(
    name = "gen_gemmini",
    outs = ["gemmini.v"],
    cmd = """
set -e
BIN=$$(readlink -f $(execpath :gemmini_emitter))
GENDIR=$$(pwd)/_gemmini_gen
mkdir -p "$$GENDIR"
( cd "$$GENDIR" && "$$BIN" ) >/dev/null
sed -E 's#@\\[([^]]*/)?(src/main/scala/[^]]*)\\]#@[\\2]#g' "$$GENDIR"/generated/*.v > $@
rm -rf "$$GENDIR"
""",
    tools = [":gemmini_emitter"],
)

alias(
    name = "rtl",
    actual = ":gen_gemmini",
    visibility = ["//visibility:public"],
)
