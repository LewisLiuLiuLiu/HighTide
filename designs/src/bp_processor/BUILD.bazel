# Black-Parrot RTL sources (hermetic).
#
# BlackParrot's bp_top/flist.vcs is curated in srcs.bzl (285 files) and sourced
# from three pinned http_archives — @bp_processor_src (BP hw) + its two vendored
# submodules @bp_basejump_stl_src / @bp_hardfloat_src — instead of the committed
# release/repo vendored tree or the dev/repo submodule.  yosys-slang reads the
# SystemVerilog directly (SYNTH_HDL_FRONTEND=slang).
#
# BP_SRCS   -> VERILOG_FILES (the compile list).
# :rtl_data -> staged into the synth sandbox for `include resolution (the full
#              archive HDL trees), NOT added to VERILOG_FILES.
#
# bsg_mem_*_synth modules are dropped from the compile list — the per-platform
# macros.v provides FakeRAM-backed replacements; stubs.v carries the small
# behavioural FF memories bsg_fakeram can't size.

load("//designs/src/bp_processor:srcs.bzl", "BP_SRCS")

# bsg_mem_*_synth are replaced by macros.v FakeRAM wrappers.
_EXCLUDED_SUFFIXES = [
    "bsg_mem_1rw_sync_synth.sv",
    "bsg_mem_1rw_sync_mask_write_bit_synth.sv",
]

filegroup(
    name = "rtl",
    srcs = [f for f in BP_SRCS if not any([f.endswith(e) for e in _EXCLUDED_SUFFIXES])] + ["stubs.v"],
    visibility = ["//visibility:public"],
)

# Full archive HDL trees, staged into the synth sandbox via the platform BUILDs'
# stage_data so yosys-slang resolves `include (bsg_defines.svh, bp_*_defines.svh,
# HardFloat headers) without the headers being added to the compile list.
filegroup(
    name = "rtl_data",
    srcs = [
        ":rtl",
        "@bp_processor_src//:hdl",
        "@bp_basejump_stl_src//:hdl",
        "@bp_hardfloat_src//:hdl",
    ],
    visibility = ["//visibility:public"],
)
